# Copy this file to  pipeline/.env  (gitignored) and fill in what you use.
# Folders and files on your machine. Leave a line empty to use the default named beside it.
# A variable that is already set in the environment wins over this file.
# (A project may keep these in pipeline/config/paths.env instead; both files are read, this one first. A name
# left empty here still counts as set: delete its line to let paths.env supply it.)
# Original X-Wing install, for its mission files (default: the standard Steam folder)
XWING_GAME_DIR=
# Your radio static beds, WAV (default pipeline/beds; src/make_beds.py writes a plain set there)
RADIO_BEDS_DIR=
# Your distress alarms, any format ffmpeg reads (default pipeline/sfx/alarm-large.wav and alarm-small.wav).
# Only a distress line needs them; build_voice.py makes none.
DISTRESS_ALARM_LARGE=
DISTRESS_ALARM_SMALL=
# ffmpeg executable (default: the one on PATH)
FFMPEG=
# Your own radio treatment, as module:function (default: the plain one in src/radio.py)
RADIO_TREATMENT=
